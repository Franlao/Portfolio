rance!":{"file":"chef-6aa6fffc6d.mp3","seconds":1.08,"env":"047873333367788778865310000"},"chef|Language processing!":{"file":"chef-2fb4ee3f15.mp3","seconds":1.54,"env":"036788888745763210238986116763006643320"},"chef|LLMs!":{"file":"chef-4c94fabce5.mp3","seconds":1.3,"env":"037876411247876531499988765421000"},"chef|Local AI!":{"file":"chef-2ff0194f42.mp3","seconds":1.54,"env":"034559998512565641277865212587776433210"},"chef|Machine learning!":{"file":"chef-bdf00e7367.mp3","seconds":1.46,"env":"0368745443567777666557777876776544321"},"chef|Multimodal!":{"file":"chef-280c689163.mp3","seconds":1.03,"env":"03468874114666789673665530"},"chef|My commis runs to the pantry and takes one jar for each skill found in your ad. That's extraction: turning free text into ingredients you can count.":{"file":"chef-dcffd80699.mp3","seconds":10.99,"env":"05898822433999999423499988510344503387641224421000000000003671136831114338998897347999985105400045312431112997763105888776567767730466532110000000000000000005994001431223149730233432110000000000001699888741113997502387301110100000268423888733699858997411135841267522477521000"},"chef|My recipe notebook. Here's how the agent handled this claim, step by step.":{"file":"chef-1c4cfd3128.mp3","seconds":5.23,"env":"05899975699311322577677611044200100000000000000000189992137983862478725651222688745752164110216665443200000110099401000077511104852"},"chef|New report in!":{"file":"chef-a1bddbadd4.mp3","seconds":1.42,"env":"035689999954661013667960036677665420"},"chef|Nicely filed!":{"file":"chef-891bb7b323.mp3","seconds":1.44,"env":"035777657752113578610188887789653210"},"chef|No copies in the window!":{"file":"chef-085a79b825.mp3","seconds":1.97,"env":"05678999872033782026663111478877954578887788854310"},"chef|No!":{"file":"chef-846c972760.mp3","seconds":0.53,"env":"02445789964210"},"chef|Not humanly possible!":{"file":"chef-726dee97f2.mp3","seconds":1.54,"env":"047799531112897676656520248721473465320"},"chef|Not that line!":{"file":"chef-8a5e