---
import "../../lab/brigade/brigade.css";
import { contact } from "../../data/contact";
import { homePath, type Lang, menuPath } from "../../i18n/ui";
import { copy } from "../../lab/brigade/copy";
import { prologueCopy } from "../../lab/brigade/prologue/copy";
import { voiceCopy } from "../../lab/brigade/voice/copy";
import Base from "../../layouts/Base.astro";
import { presets } from "../../lib/offer/presets";
import { getProjectCards } from "../../lib/projects";
import Arrival from "../brigade/Arrival.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
// French copy is already typographized in copy.ts.
const t = copy[lang];
const voice = voiceCopy[lang];
const projects = await getProjectCards(lang);
const alternates = { fr: homePath("fr"), en: homePath("en") };
const languages = ["fr", "en"] as const;
const outcomes = ["offer", "missing", "escalation"] as const;
---

<Base lang={lang} alternates={alternates} title={t.meta.title} description={t.meta.description}>
	<main class="brigade-stage">
		<Arrival lang={lang} menuHref={menuPath(lang)} />
		<canvas id="brigade-canvas" role="img" aria-label={t.intro.canvas}></canvas>

		<header class="intro">
			<h1>Solim Laokpezi</h1>
			<p class="intro-role">{t.intro.role}</p>
			<p class="intro-text-version">
				<a href={menuPath(lang)}>{t.intro.menu}</a>
				<a class="replay-link" href="?arrivee">{prologueCopy[lang].replay}</a>
			</p>
			<p>{t.intro.text}</p>
		</header>

		<section class="orders" aria-labelledby="orders-title">
			<p class="orders-title" id="orders-title">{t.orders.title}</p>
			<ul>
				{
					presets.map((preset) => (
						<li>
							<button type="button" class="order" data-order={preset.id}>
								<span class="order-kind">{t.orders.kind}</span>
								<span class="order-label">{preset.label[lang]}</span>
							</button>
						</li>
					))
				}
				<li>
					<button type="button" class="order order-write">
						<span class="order-kind">{t.orders.writeKind}</span>
						<span class="order-label">{t.orders.writeLabel}</span>
					</button>
				</li>
			</ul>
		</section>

		<section class="ticket" hidden aria-labelledby="ticket-number">
			<p class="ticket-number" id="ticket-number"></p>
			<p class="ticket-table">{t.ticket.table}</p>
			<p class="ticket-title"></p>
			<ol class="ticket-lines"></ol>
			<p class="ticket-foot" aria-live="polite"></p>
		</section>

		<!-- Focused when served (main.ts), so it is announced once rather than as a live region. -->
		<section class="dish panel" hidden tabindex="-1" aria-labelledby="dish-title">
			<h2 id="dish-title">{t.dish.title}</h2>
			<p>{t.dish.intro}</p>
			<ol class="dish-list"></ol>
			<p class="dish-outside panel-note" hidden></p>
			<p class="panel-note">{t.dish.note}</p>
		</section>

		<section class="visit panel" hidden aria-labelledby="visit-name">
			<button type="button" class="visit-back">{t.visit.back}</button>
			<h2 class="visit-name" id="visit-name"></h2>
			<p class="visit-project"></p>
			<p class="visit-concept"></p>
			<p class="visit-summary"></p>
			<div class="visit-actions">
				<button type="button" class="visit-rush" hidden>{t.visit.play}</button>
				<a class="visit-play" hidden>{t.visit.read}</a>
			</div>
			<p class="visit-soon panel-note">{t.visit.soon}</p>
		</section>

		<section class="rush" hidden aria-labelledby="rush-title">
			<header class="rush-head">
				<h2 id="rush-title">{t.rush.title}</h2>
				<p class="rush-progress" aria-live="polite"></p>
				<label class="rush-relax"><input type="checkbox" /> {t.rush.relax}</label>
				<button type="button" class="rush-quit">{t.quit}</button>
			</header>

			<div class="rush-play">
				<div class="rush-rules">
					<h3>{t.rush.rulesTitle}</h3>
					<ul>
						{t.rush.rules.map((rule) => <li>{rule}</li>)}
					</ul>
				</div>

				<article class="rush-ticket" id="rush-case">
					<p class="rush-story"></p>
					<ul class="rush-pieces"></ul>
					<dl class="rush-facts">
						<div><dt>{t.rush.delay}</dt><dd class="rush-delay"></dd></div>
						<div><dt>{t.rush.quote}</dt><dd class="rush-amount"></dd></div>
					</dl>
					<div class="rush-timer" aria-hidden="true"><span></span></div>
					<p class="rush-stamp" aria-hidden="true"></p>
				</article>

				<!-- The case is described on the group: a screen reader hears it on reaching the choices. -->
				<div class="rush-choices" role="group" aria-label={t.rush.decision} aria-describedby="rush-case">
					{
						outcomes.map((outcome, index) => (
							<button type="button" class="rush-choice" data-choice={outcome}>
								<kbd>{index + 1}</kbd> {t.rush.outcomes[outcome]}
							</button>
						))
					}
				</div>

				<div class="rush-verdict" hidden aria-live="polite">
					<p class="rush-verdict-head"></p>
					<p class="rush-verdict-chef"></p>
					<ul class="rush-reasons"></ul>
					<button type="button" class="rush-next">{t.rush.next}</button>
				</div>
			</div>

			<div class="rush-end" hidden aria-live="polite">
				<h3>{t.rush.endTitle}</h3>
				<p class="rush-score"></p>
				<p class="rush-chef"></p>
				<div class="rush-end-actions">
					<button type="button" class="rush-again">{t.rush.again}</button>
					<button type="button" class="rush-notebook">{t.rush.howItDecides}</button>
				</div>
			</div>
		</section>

		<section class="game" hidden aria-labelledby="game-title">
			<header class="rush-head">
				<h2 id="game-title" class="game-title"></h2>
				<button type="button" class="rush-quit game-quit">{t.quit}</button>
			</header>
			<p class="game-intro"></p>
			<div class="game-body"></div>
		</section>

		<div class="brigade-corner">
			<button type="button" class="bill-open">{t.bill.open}</button>
			<button type="button" class="sound-toggle" aria-pressed="false">{t.sound.enable}</button>
			<button type="button" class="captions-toggle" aria-pressed="false" hidden>{voice.captions}</button>
			<nav class="lang-switch" aria-label={t.language}>
				{
					languages.map((code) =>
						code === lang ? (
							<span aria-current="true">{code.toUpperCase()}</span>
						) : (
							<a href={homePath(code)} hreflang={code} lang={code}>
								{code.toUpperCase()}
							</a>
						),
					)
				}
			</nav>
		</div>

		<dialog class="bill" aria-labelledby="bill-title">
			<form method="dialog" class="bill-paper">
				<p class="bill-house">La Brigade · Lyon</p>
				<h2 id="bill-title" class="bill-title">{t.bill.title}</h2>
				<p class="bill-table">{t.bill.table}</p>
				<ol class="bill-lines"></ol>
				<p class="bill-empty">{t.bill.empty}</p>
				<p class="bill-total"><span>{t.bill.total}</span><span>{t.bill.totalValue}</span></p>
				<p class="bill-settle">{t.bill.settle}</p>
				<div class="bill-actions">
					<a class="bill-write" href={`mailto:${contact.email}?subject=${encodeURIComponent(t.bill.mailSubject)}`}>{t.bill.write}</a>
					<a class="bill-cv" href={contact.cv[lang]} target="_blank" rel="noopener">{t.bill.cv}<span class="visually-hidden"> {t.bill.newTab}</span></a>
				</div>
				<p class="bill-links">
					<a href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
					<a href={contact.github} target="_blank" rel="noopener">GitHub</a>
					<a href={`mailto:${contact.email}`}>{contact.email}</a>
				</p>
				<button type="button" class="bill-share">{t.bill.share}</button>
				<p class="bill-shared" role="status"></p>
				<input class="bill-link" type="text" readonly hidden aria-label={t.bill.linkLabel} />
				<p class="bill-voices">{voice.credit}</p>
				<button type="submit" class="bill-close">{t.bill.close}</button>
			</form>
		</dialog>

		<dialog class="write" aria-label={t.orders.writeLabel}>
			<form method="dialog">
				<label for="write-text">{t.write.label}</label>
				<textarea
					id="write-text"
					rows="8"
					placeholder={t.write.placeholder}
					aria-describedby="write-privacy write-error"></textarea>
				<p class="write-privacy" id="write-privacy">{t.write.privacy}</p>
				<p class="write-error" id="write-error" role="alert"></p>
				<div class="write-actions">
					<button type="submit" class="write-send">{t.write.send}</button>
					<button type="button" class="write-cancel">{t.write.cancel}</button>
				</div>
			</form>
		</dialog>
	</main>

	<script type="application/json" id="brigade-data" set:html={JSON.stringify(projects)} />
	<script>
		import { start } from "../../lab/brigade/main";

		start();
	</script>
</Base>
