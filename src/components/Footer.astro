---
import { getTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
}

const t = getTranslations(Astro.props.lang);
---

<footer class="sheet site-footer">
	<p>{t("footer.note")}</p>
	<p><a href="https://github.com/Franlao/Portfolio">{t("footer.source")}</a></p>
</footer>

<style>
	.site-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2) var(--space-5);
		margin-top: var(--space-8);
		padding-block: var(--space-5) var(--space-6);
		font-size: var(--step--1);
		color: var(--ink-soft);
		border-top: 1.5px solid var(--rule);
	}
</style>
