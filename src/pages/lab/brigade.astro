---
import "../../lab/brigade/brigade.css";
import Base from "../../layouts/Base.astro";
import { presets } from "../../lib/offer/presets";
import { getProjectCards } from "../../lib/projects";

const projects = await getProjectCards("fr");
---

<Base
	lang="fr"
	alternates={{ fr: "/lab/brigade/", en: "/lab/brigade/" }}
	title="La Brigade, Solim Laokpezi"
	description="Prototype : les projets d'un AI Engineer présentés comme une brigade de cuisine."
>
	<div class="brigade-stage">
		<canvas id="brigade-canvas" aria-label="La cuisine en 3D. Les postes sont aussi accessibles par les étiquettes."></canvas>

		<header class="intro">
			<h1>Solim Laokpezi</h1>
			<p class="intro-role">AI Engineer, Lyon</p>
			<p class="intro-text-version"><a href="/">Pressé ? La version texte</a></p>
			<p>
				Mes agents IA travaillent comme une brigade : chacun son poste, et rien ne sort sans passer par le chef. Passez
				commande, la cuisine prépare les projets qui répondent à votre poste.
			</p>
		</header>

		<nav class="orders" aria-label="Passer commande">
			<p class="orders-title">Passer commande</p>
			<ul>
				{
					presets.map((preset) => (
						<li>
							<button type="button" class="order" data-order={preset.id}>
								<span class="order-kind">Commande</span>
								<span class="order-label">{preset.label.fr}</span>
							</button>
						</li>
					))
				}
				<li>
					<button type="button" class="order order-write">
						<span class="order-kind">Votre offre</span>
						<span class="order-label">Écrire ma commande</span>
					</button>
				</li>
			</ul>
		</nav>

		<aside class="ticket" hidden aria-live="polite">
			<p class="ticket-number"></p>
			<p class="ticket-table">Table : recruteur</p>
			<p class="ticket-title"></p>
			<ol class="ticket-lines"></ol>
			<p class="ticket-foot"></p>
		</aside>

		<section class="dish panel" hidden aria-live="polite">
			<h2>Le plat est prêt</h2>
			<p>Pour ce poste, la brigade vous sert :</p>
			<ol class="dish-list"></ol>
			<p class="panel-note">Choisissez un plat pour visiter son poste.</p>
		</section>

		<section class="visit panel" hidden>
			<button type="button" class="visit-back">Revenir à la cuisine</button>
			<h2 class="visit-name"></h2>
			<p class="visit-project"></p>
			<p class="visit-concept"></p>
			<p class="visit-summary"></p>
			<div class="visit-actions">
				<button type="button" class="visit-rush" hidden>Jouer à ce poste</button>
				<a class="visit-play" hidden>Lire le projet</a>
			</div>
			<p class="visit-soon panel-note">Ce poste ouvre bientôt.</p>
		</section>

		<section class="rush" hidden aria-labelledby="rush-title">
			<header class="rush-head">
				<h2 id="rush-title">Coup de feu au passe</h2>
				<p class="rush-progress" aria-live="polite"></p>
				<label class="rush-relax"><input type="checkbox" /> Sans chrono</label>
				<button type="button" class="rush-quit">Quitter</button>
			</header>

			<div class="rush-play">
				<aside class="rush-rules">
					<h3>Le règlement de la maison</h3>
					<ul>
						<li>Déclaration sous 5 jours.</li>
						<li>Plafond de garantie : 15 000 €.</li>
						<li>Pièces obligatoires : déclaration, photos, devis.</li>
						<li>Version contestée : il faut l'attestation du voisin.</li>
						<li>Orage ou tempête : exclusion possible, au gestionnaire de trancher.</li>
					</ul>
				</aside>

				<article class="rush-ticket">
					<p class="rush-story"></p>
					<ul class="rush-pieces"></ul>
					<dl class="rush-facts">
						<div><dt>Déclaré au bout de</dt><dd class="rush-delay"></dd></div>
						<div><dt>Devis</dt><dd class="rush-amount"></dd></div>
					</dl>
					<div class="rush-timer" aria-hidden="true"><span></span></div>
					<p class="rush-stamp" aria-hidden="true"></p>
				</article>

				<div class="rush-choices" role="group" aria-label="Votre décision">
					<button type="button" class="rush-choice" data-choice="offer"><kbd>1</kbd> Proposer l'indemnisation</button>
					<button type="button" class="rush-choice" data-choice="missing"><kbd>2</kbd> Réclamer une pièce</button>
					<button type="button" class="rush-choice" data-choice="escalation"><kbd>3</kbd> Transmettre au gestionnaire</button>
				</div>

				<div class="rush-verdict" hidden aria-live="polite">
					<p class="rush-verdict-head"></p>
					<p class="rush-verdict-chef"></p>
					<ul class="rush-reasons"></ul>
					<button type="button" class="rush-next">Dossier suivant</button>
				</div>
			</div>

			<div class="rush-end" hidden aria-live="polite">
				<h3>Service terminé</h3>
				<p class="rush-score"></p>
				<p class="rush-chef"></p>
				<div class="rush-end-actions">
					<button type="button" class="rush-again">Rejouer</button>
					<a href="/projets/claims-agent/">Voir comment l'agent décide</a>
				</div>
			</div>
		</section>

		<section class="game" hidden aria-labelledby="game-title">
			<header class="rush-head">
				<h2 id="game-title" class="game-title"></h2>
				<button type="button" class="rush-quit game-quit">Quitter</button>
			</header>
			<p class="game-intro"></p>
			<div class="game-body"></div>
		</section>

		<button type="button" class="sound-toggle" aria-pressed="false">Activer le son</button>

		<dialog class="write">
			<form method="dialog">
				<label for="write-text">Collez l'offre d'emploi : la brigade la lit comme un bon de commande.</label>
				<textarea id="write-text" rows="8" placeholder="Collez ici le texte de l'offre."></textarea>
				<p class="write-error" role="alert"></p>
				<div class="write-actions">
					<button type="submit" class="write-send">Envoyer en cuisine</button>
					<button type="button" class="write-cancel">Annuler</button>
				</div>
			</form>
		</dialog>
	</div>

	<script type="application/json" id="brigade-data" set:html={JSON.stringify(projects)} />
	<script>
		import { start } from "../../lab/brigade/main";

		start();
	</script>
</Base>
