---
import "../styles/global.css";
import { getTranslations, type Lang } from "../i18n/ui";

interface Props {
	lang: Lang;
	alternates: Record<Lang, string>;
	title?: string;
	description?: string;
	/** Preview image for links shared on LinkedIn, Slack, WhatsApp…: 1200 × 630. */
	image?: string;
}

const { lang, alternates } = Astro.props;
const t = getTranslations(lang);
const title = Astro.props.title ?? t("site.title");
const description = Astro.props.description ?? t("site.description");
const site = Astro.site ?? Astro.url;
const absolute = (path: string) => new URL(path, site).href;
const canonical = absolute(Astro.url.pathname);
const image = absolute(Astro.props.image ?? `/og/brigade-${lang}.jpg`);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href="/fonts/recursive-latin-casl.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="fr" href={absolute(alternates.fr)} />
		<link rel="alternate" hreflang="en" href={absolute(alternates.en)} />
		<link rel="alternate" hreflang="x-default" href={absolute(alternates.fr)} />
		<meta name="theme-color" content="#ecf1e6" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#191d1a" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={lang === "fr" ? "fr_FR" : "en_GB"} />
		<meta property="og:site_name" content="Solim Laokpezi" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t("site.imageAlt")} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
	</head>
	<body>
		<slot />
	</body>
</html>
